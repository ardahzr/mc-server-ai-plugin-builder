@{
    ViewData["Title"] = "AI Plugin Builder";
    var existingPlugins = (ViewBag.ExistingPlugins as List<McPanel.Services.PluginInfo>) ?? new List<McPanel.Services.PluginInfo>();
}

<style>
    /* ===== WIZARD LAYOUT ===== */
    .wizard-container { max-width: 1200px; margin: 0 auto; }

    /* Top stepper bar */
    .stepper-bar { display: flex; gap: 6px; margin-bottom: 24px; padding: 6px; border-radius: 20px; background: var(--surface); border: 1px solid var(--line); }
    .stepper-step { flex: 1; padding: 12px 16px; border-radius: 14px; position: relative; display: flex; align-items: center; gap: 12px; cursor: default; transition: background-color .25s ease, opacity .25s ease; min-width: 0; }
    .stepper-step.active { background: rgba(255,255,255,.06); box-shadow: inset 0 0 0 1px rgba(255,255,255,.08); }
    .stepper-step.completed { background: transparent; }
    .stepper-step.completed .step-icon { background: var(--grass) !important; color: #03140a !important; }
    .stepper-step.disabled { opacity: 0.45; }
    .step-icon { width: 36px; height: 36px; border-radius: 11px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.95rem; flex-shrink: 0; }
    .step-icon.blueprint { background: rgba(94,230,240,.12); color: var(--diamond); }
    .step-icon.generate { background: rgba(167,139,250,.14); color: var(--amethyst); }
    .step-icon.download { background: rgba(255,255,255,.06); color: var(--ink-3); }
    .step-title { font-weight: 600; color: #fff; font-size: 0.9rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .step-desc { color: var(--ink-3); font-size: 0.75rem; margin-top: 1px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    /* Main layout: content + sidebar */
    .wizard-body { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 20px; }
    .wizard-main { min-width: 0; }
    .wizard-sidebar { position: sticky; top: 84px; align-self: start; }

    /* Cards */
    .wiz-card { background: var(--surface); border: 1px solid var(--line); border-radius: 18px; margin-bottom: 16px; overflow: hidden; }
    .wiz-card-header { padding: 15px 20px; border-bottom: 1px solid var(--line); display: flex; align-items: center; gap: 10px; cursor: pointer; }
    .wiz-card-header h5 { margin: 0; font-size: 0.95rem; font-weight: 600; color: #fff; letter-spacing: -.01em; }
    .wiz-card-body { padding: 20px; }

    /* Question items */
    .question-item { margin-bottom: 18px; padding-bottom: 18px; border-bottom: 1px solid var(--line); }
    .question-item:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
    .q-number { width: 28px; height: 28px; background: var(--surface-3); border: 1px solid var(--line-2); border-radius: 9px; display: inline-flex; align-items: center; justify-content: center; font-weight: 600; font-size: 0.78rem; color: var(--ink-2); margin-right: 12px; flex-shrink: 0; transition: all .2s ease; }
    .q-number.answered { background: var(--grass); border-color: transparent; color: #03140a; }
    .q-text { color: var(--ink-2); font-size: 0.92rem; line-height: 1.55; padding-top: 3px; }
    .q-input { margin-top: 10px; font-size: 0.88rem; }

    /* Progress bar */
    .progress-thin { height: 4px; background: rgba(255,255,255,.06); border-radius: 4px; overflow: hidden; }
    .progress-thin .bar { height: 100%; background: linear-gradient(90deg, var(--grass), var(--diamond)); transition: width 0.4s; border-radius: 4px; }

    /* Blueprint sections */
    .bp-section { margin-bottom: 12px; }
    .bp-section-header { padding: 12px 16px; background: var(--surface-2); border-radius: 12px; display: flex; align-items: center; gap: 10px; cursor: pointer; }
    .bp-section-header i { font-size: 1.1rem; }
    .bp-section-header h6 { margin: 0; font-weight: 600; color: #fff; font-size: 0.88rem; }
    .bp-section-body { padding: 12px 16px; }
    .bp-tag { display: inline-block; padding: 3px 9px; border-radius: 7px; font-size: 0.7rem; font-weight: 700; letter-spacing: .03em; margin-right: 6px; }
    .bp-tag-green { background: rgba(94,224,122,.12); color: var(--grass); }
    .bp-tag-blue { background: rgba(94,230,240,.1); color: var(--diamond); }
    .bp-tag-yellow { background: rgba(247,194,74,.12); color: var(--gold); }
    .bp-tag-red { background: rgba(255,90,95,.12); color: #ff9497; }
    .bp-tag-purple { background: rgba(167,139,250,.14); color: var(--amethyst); }
    .verified-icon { color: var(--grass); }

    /* User story card */
    .story-card { background: var(--surface-2); border: 1px solid var(--line); border-radius: 12px; padding: 12px 16px; margin-bottom: 8px; }

    /* Sidebar cards */
    .sidebar-card { background: var(--surface); border: 1px solid var(--line); border-radius: 18px; padding: 20px; margin-bottom: 16px; }
    .sidebar-card h6 { font-size: 0.78rem; font-weight: 600; color: var(--ink-3); text-transform: uppercase; letter-spacing: .07em; margin-bottom: 16px; display: flex; align-items: center; gap: 7px; }
    .sidebar-card h6 i { color: var(--gold); }
    .how-step { display: flex; gap: 12px; margin-bottom: 14px; }
    .how-step:last-child { margin-bottom: 0; }
    .how-step-num { width: 26px; height: 26px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.74rem; flex-shrink: 0; }
    .how-step-num.s1 { background: rgba(94,230,240,.12); color: var(--diamond); }
    .how-step-num.s2 { background: rgba(167,139,250,.14); color: var(--amethyst); }
    .how-step-num.s3 { background: rgba(94,224,122,.14); color: var(--grass); }
    .how-step-title { font-weight: 600; color: #fff; font-size: 0.85rem; }
    .how-step-desc { color: var(--ink-3); font-size: 0.76rem; }
    .info-row { display: flex; justify-content: space-between; gap: 12px; padding: 8px 0; border-bottom: 1px solid var(--line); font-size: 0.8rem; }
    .info-row:last-child { border-bottom: none; }
    .info-label { color: var(--ink-4); font-weight: 500; letter-spacing: .03em; }
    .info-value { color: #fff; font-weight: 600; text-align: right; font-family: var(--mono); font-size: .76rem; word-break: break-word; }

    /* Create form */
    .create-hero { text-align: center; padding: 40px 20px 36px; }
    .create-hero h2 { color: #fff; font-weight: 500; font-size: clamp(32px, 4vw, 48px); letter-spacing: -.035em; line-height: 1.05; margin: 14px 0 12px; }
    .create-hero p { color: var(--ink-3); font-size: 1.05rem; max-width: 52ch; margin: 0 auto; }
    .create-form { max-width: 640px; margin: 0 auto; }
    .create-form textarea { resize: vertical; min-height: 120px; }

    /* Existing plugins grid */
    .section-label { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
    .section-label h5 { margin: 0; font-size: .95rem; font-weight: 600; }
    .plugins-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px; margin-bottom: 28px; }
    .plugin-card { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 16px; transition: border-color .2s ease, transform .2s ease; display: flex; flex-direction: column; gap: 4px; }
    .plugin-card:hover { border-color: rgba(247,194,74,.4); transform: translateY(-2px); }
    .plugin-card-top { display: flex; align-items: center; gap: 10px; }
    .plugin-card-icon { width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; background: rgba(247,194,74,.12); color: var(--gold); flex-shrink: 0; }
    .plugin-card h6 { color: #fff; margin: 0; font-weight: 600; font-size: .92rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .plugin-card .meta { color: var(--ink-4); font-size: .76rem; font-family: var(--mono); }

    /* Loading spinner */
    .wizard-spinner { display: inline-block; width: 20px; height: 20px; border: 3px solid rgba(255,255,255,.1); border-top-color: var(--grass); border-radius: 50%; animation: wspin 0.8s linear infinite; vertical-align: middle; }
    @@keyframes wspin { to { transform: rotate(360deg); } }

    /* Build output */
    .build-output { background: #08090b; border: 1px solid var(--line); border-radius: 12px; padding: 14px; font-family: var(--mono); font-size: 0.78rem; color: var(--ink-3); max-height: 300px; overflow-y: auto; white-space: pre-wrap; }

    /* Responsive */
    @@media (max-width: 900px) {
        .wizard-body { grid-template-columns: minmax(0, 1fr); }
        .wizard-sidebar { position: static; }
        .stepper-bar { flex-direction: column; }
    }

    /* Edit mode panel */
    .edit-panel { display: none; }
    .edit-panel.show { display: block; }

    /* ===== EDIT MODE ===== */
    .edit-stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 10px; }
    .edit-stat-card { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 16px; text-align: left; transition: border-color .2s ease, transform .2s ease; }
    .edit-stat-card:hover { border-color: rgba(94,224,122,.35); transform: translateY(-2px); }
    .edit-stat-icon { font-size: 1.1rem; margin-bottom: 10px; }
    .edit-stat-value { font-size: 1.6rem; font-weight: 500; color: #fff; letter-spacing: -.03em; line-height: 1; }
    .edit-stat-label { font-size: 0.7rem; color: var(--ink-4); text-transform: uppercase; letter-spacing: 0.06em; margin-top: 6px; }

    .edit-file-item { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: 10px; cursor: pointer; font-size: 0.82rem; color: var(--ink-2); transition: background-color .15s ease, color .15s ease; margin-bottom: 2px; border-left: 0; min-width: 0; }
    .edit-file-item > div { min-width: 0; }
    .edit-file-item:hover { background: rgba(255,255,255,.05); color: #fff; }
    .edit-file-item.active { background: rgba(94,224,122,.1); color: var(--grass); box-shadow: inset 2px 0 0 var(--grass); }
    .edit-file-item .file-icon { font-size: 1rem; flex-shrink: 0; }
    .edit-file-item .file-name { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .edit-file-item .file-path { font-size: 0.66rem; color: var(--ink-4); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-family: var(--mono); }

    .edit-code-block { margin: 0; padding: 16px 18px; background: #08090b; color: #d7dbe2; font-family: var(--mono); font-size: 0.78rem; line-height: 1.7; white-space: pre-wrap; word-wrap: break-word; tab-size: 4; }

    .edit-chat-container { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 12px; }
    .edit-chat-msg { max-width: 92%; animation: editMsgSlide 0.3s ease-out; }
    .edit-chat-msg.user { align-self: flex-end; }
    .edit-chat-msg.ai { align-self: flex-start; }
    .edit-chat-bubble { padding: 10px 14px; border-radius: 16px; font-size: 0.87rem; line-height: 1.55; }
    .edit-chat-bubble p:last-child { margin-bottom: 0; }
    .edit-chat-bubble pre { background: #08090b; border: 1px solid var(--line); border-radius: 8px; padding: 10px; font-size: 0.75rem; margin: 6px 0; overflow-x: auto; }
    .edit-chat-bubble code { font-size: 0.78rem; }
    .edit-chat-msg.user .edit-chat-bubble { background: rgba(94,224,122,.12); border: 1px solid rgba(94,224,122,.22); color: #d8fbe0; border-bottom-right-radius: 5px; }
    .edit-chat-msg.ai .edit-chat-bubble { background: var(--surface-2); color: var(--ink-2); border: 1px solid var(--line); border-bottom-left-radius: 5px; }
    .edit-chat-sender { font-size: 0.66rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 4px; }
    .edit-chat-msg.user .edit-chat-sender { color: rgba(94,224,122,.8); text-align: right; }
    .edit-chat-msg.ai .edit-chat-sender { color: var(--ink-4); }
    @@keyframes editMsgSlide { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

    .edit-chat-input-area { padding: 12px; border-top: 1px solid var(--line); }
    .edit-chat-hints { display: flex; gap: 6px; margin-top: 10px; flex-wrap: wrap; }
    .edit-hint-chip { padding: 4px 10px; background: rgba(255,255,255,.04); border: 1px solid var(--line-2); border-radius: 999px; font-size: 0.72rem; color: var(--ink-3); cursor: pointer; transition: all 0.15s; white-space: nowrap; display: inline-flex; align-items: center; gap: 5px; }
    .edit-hint-chip:hover { background: rgba(255,255,255,.08); color: #fff; border-color: rgba(247,194,74,.45); }

    .edit-file-tabs { display: flex; gap: 0; overflow-x: auto; border-bottom: 1px solid var(--line); background: var(--surface); scrollbar-width: thin; flex-shrink: 0; }
    .edit-file-tab { padding: 9px 14px; font-size: 0.76rem; color: var(--ink-3); cursor: pointer; border-bottom: 2px solid transparent; white-space: nowrap; transition: all 0.15s; display: flex; align-items: center; gap: 6px; }
    .edit-file-tab:hover { color: #fff; background: rgba(255,255,255,.03); }
    .edit-file-tab.active { color: #fff; border-bottom-color: var(--grass); background: #08090b; }
    .edit-file-tab .tab-icon { font-size: 0.85rem; }

    .edit-typing-dots { display: inline-flex; gap: 4px; padding: 4px 0; }
    .edit-typing-dots span { width: 6px; height: 6px; background: var(--ink-3); border-radius: 50%; animation: editDotBounce 1.4s infinite ease-in-out both; }
    .edit-typing-dots span:nth-child(1) { animation-delay: -0.32s; }
    .edit-typing-dots span:nth-child(2) { animation-delay: -0.16s; }
    @@keyframes editDotBounce { 0%, 80%, 100% { transform: scale(0); } 40% { transform: scale(1); } }

    .edit-example-list { display: flex; flex-direction: column; gap: 6px; }
    .edit-example { padding: 9px 12px; background: var(--surface-2); border: 1px solid var(--line); border-radius: 10px; font-size: 0.78rem; color: var(--ink-2); cursor: pointer; transition: all 0.15s; display: flex; align-items: center; gap: 9px; }
    .edit-example:hover { background: var(--surface-3); color: #fff; border-color: var(--line-2); }

    .edit-build-phases { display: flex; flex-direction: column; gap: 8px; margin: 16px 0; }
    .edit-build-phase { display: flex; align-items: center; gap: 12px; padding: 12px 16px; background: var(--surface-2); border: 1px solid var(--line); border-radius: 12px; transition: all 0.3s; }
    .edit-build-phase.active { border-color: rgba(247,194,74,.35); background: rgba(247,194,74,.05); }
    .edit-build-phase.done { border-color: rgba(94,224,122,.25); background: rgba(94,224,122,.04); }
    .edit-build-phase.error { border-color: rgba(255,90,95,.35); background: rgba(255,90,95,.05); }
    .edit-phase-icon { width: 32px; height: 32px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 0.9rem; }
    .edit-build-phase.pending .edit-phase-icon { background: rgba(255,255,255,.05); color: var(--ink-4); }
    .edit-build-phase.active .edit-phase-icon { background: rgba(247,194,74,.14); color: var(--gold); animation: editPulse 1.5s infinite; }
    .edit-build-phase.done .edit-phase-icon { background: rgba(94,224,122,.14); color: var(--grass); }
    .edit-build-phase.error .edit-phase-icon { background: rgba(255,90,95,.14); color: #ff9497; }
    .edit-phase-label { font-weight: 600; color: #fff; font-size: 0.86rem; }
    .edit-phase-desc { font-size: 0.74rem; color: var(--ink-3); }
    @@keyframes editPulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(247,194,74,0.3); } 50% { box-shadow: 0 0 0 8px rgba(247,194,74,0); } }

    .edit-success-container { text-align: center; padding: 32px 20px; }
    .edit-success-icon { font-size: 3.5rem; color: var(--grass); animation: editSuccessPop 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55); }
    @@keyframes editSuccessPop { 0% { transform: scale(0); } 100% { transform: scale(1); } }
    .edit-retry-badge { display: inline-flex; align-items: center; gap: 5px; padding: 4px 12px; background: rgba(247,194,74,.12); color: var(--gold); border-radius: 999px; font-size: 0.74rem; font-weight: 600; }

    .page-back { width: 38px; height: 38px; padding: 0; border-radius: 12px; }
</style>

<!-- ========== STEP 0: CREATE / SELECT ========== -->
<div id="stepCreate" class="wizard-container">
    <div class="create-hero">
        <span class="eyebrow-sm" lang="en"><i class="bi bi-stars"></i> AI Plugin Builder</span>
        <h2>Fikrini anlat,<br />plugin'i biz yazalım.</h2>
        <p>Minecraft Spigot plugin'ini yapay zekâ ile oluştur. Sorular, blueprint, kod, derleme ve kurulum — hepsi tek akışta.</p>
    </div>

    <!-- Existing Plugins -->
    @if (existingPlugins.Count > 0)
    {
        <div class="mb-4">
            <div class="section-label"><h5>Mevcut projeler</h5><span class="badge bg-secondary">@existingPlugins.Count</span></div>
            <div class="plugins-grid">
                @foreach (var plugin in existingPlugins)
                {
                    <div class="plugin-card">
                        <div class="plugin-card-top">
                            <span class="plugin-card-icon"><i class="bi bi-puzzle-fill"></i></span>
                            <div style="min-width:0">
                                <h6>@plugin.Name</h6>
                                <div class="meta">@plugin.SourceFiles.Count dosya</div>
                            </div>
                        </div>
                        <div class="d-flex gap-2 mt-3">
                            <button class="btn btn-sm btn-outline-info" onclick="loadPluginSource('@plugin.Name')">
                                <i class="bi bi-eye"></i> Gor
                            </button>
                            <button class="btn btn-sm btn-outline-warning" onclick="editPluginWithAI('@plugin.Name')">
                                <i class="bi bi-pencil"></i> Duzenle
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- New Plugin Form -->
    <div class="wiz-card">
        <div class="wiz-card-header">
            <i class="bi bi-plus-circle-fill text-success"></i>
            <h5>Yeni plugin oluştur</h5>
        </div>
        <div class="wiz-card-body">
            <div class="create-form">
                <div class="mb-3">
                    <label class="form-label small" for="pluginName">Plugin adı</label>
                    <input type="text" id="pluginName" class="form-control" placeholder="Örn: MobKill, PvPArena, LootChest…" />
                </div>
                <div class="mb-3">
                    <label class="form-label small" for="pluginDesc">Ne yapmak istiyorsun? (Detaylı anlat)</label>
                    <textarea id="pluginDesc" class="form-control" rows="4" placeholder="Örn: Her mob öldürüldüğünde oyuncuya 5 altın versin. Farklı moblara farklı ödül olsun. /mobkill komutuyla istatistik göstersin."></textarea>
                </div>
                <button class="btn btn-mc w-100 py-2" onclick="startWizard()">
                    <i class="bi bi-rocket-takeoff-fill"></i> Başla
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========== STEP 1-3: WIZARD ========== -->
<div id="wizardMain" class="wizard-container" style="display:none;">
    <!-- Back button + title -->
    <div class="d-flex align-items-center gap-3 mb-3">
        <button class="btn btn-sm btn-outline-secondary page-back" onclick="goBack()" title="Geri" aria-label="Geri"><i class="bi bi-arrow-left"></i></button>
        <div>
            <h4 class="text-white mb-0" id="wizPluginTitle">PluginName</h4>
            <div class="d-flex gap-2 mt-1">
                <span class="badge bg-secondary">Spigot</span>
                <span class="badge bg-secondary">MC 1.21</span>
            </div>
        </div>
    </div>

    <!-- Stepper -->
    <div class="stepper-bar">
        <div class="stepper-step active" id="stepper1">
            <div class="step-icon blueprint"><i class="bi bi-clipboard-check-fill"></i></div>
            <div>
                <div class="step-title">Blueprint Ready</div>
                <div class="step-desc">Gereksinimleri belirle</div>
            </div>
        </div>
        <div class="stepper-step disabled" id="stepper2">
            <div class="step-icon generate"><i class="bi bi-code-slash"></i></div>
            <div>
                <div class="step-title">Generate Release</div>
                <div class="step-desc">Kodu uret ve derle</div>
            </div>
        </div>
        <div class="stepper-step disabled" id="stepper3">
            <div class="step-icon download"><i class="bi bi-download"></i></div>
            <div>
                <div class="step-title">Download</div>
                <div class="step-desc">JAR dosyasini indir</div>
            </div>
        </div>
    </div>

    <div class="wizard-body">
        <!-- ===== MAIN CONTENT ===== -->
        <div class="wizard-main">

            <!-- STEP 1: Clarification Questions -->
            <div id="stepQuestions">
                <div class="wiz-card">
                    <div class="wiz-card-header">
                        <i class="bi bi-question-circle-fill text-info"></i>
                        <h5>Clarification Questions</h5>
                        <span class="text-muted ms-auto small">Gereksinimlerini anlamak icin yardim et</span>
                    </div>
                    <div class="wiz-card-body">
                        <!-- Progress -->
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="progress-thin flex-fill">
                                <div class="bar" id="questionProgress" style="width: 0%"></div>
                            </div>
                            <span class="text-muted small" id="questionCount">0/5</span>
                        </div>

                        <div id="questionsList">
                            <div class="text-center py-4">
                                <div class="wizard-spinner"></div>
                                <p class="text-muted mt-2 small">AI sorulari hazirlaniyor...</p>
                            </div>
                        </div>

                        <div class="mt-3 text-muted small">
                            <i class="bi bi-info-circle"></i> Cevaplarin AI'in daha isabetli plugin olusturmasina yardimci olur. Bos birakilabilir.
                        </div>

                        <button class="btn btn-mc w-100 mt-3 py-2" id="btnSubmitAnswers" onclick="submitAnswers()" disabled>
                            <i class="bi bi-check2-circle"></i> Gonder & Devam Et
                        </button>
                    </div>
                </div>
            </div>

            <!-- STEP 2: Blueprint -->
            <div id="stepBlueprint" style="display:none;">
                <div id="blueprintContent">
                    <div class="text-center py-5">
                        <div class="wizard-spinner"></div>
                        <p class="text-muted mt-2">Blueprint hazirlaniyor...</p>
                    </div>
                </div>

                <button class="btn btn-mc w-100 mt-3 py-2" id="btnGenerateRelease" onclick="generateRelease()" style="display:none;">
                    <i class="bi bi-play-fill"></i> Generate Release — Kodu Uret & Derle
                </button>
            </div>

            <!-- STEP 3: Build / Download -->
            <div id="stepBuild" style="display:none;">
                <div class="wiz-card">
                    <div class="wiz-card-header">
