                    <div class="text-center py-3"><div class="wizard-spinner"></div></div>
                </div>
            </div>
            <div class="sidebar-card">
                <h6><i class="bi bi-lightbulb-fill"></i> Düzenleme İpuçları</h6>
                <div class="how-step"><div class="how-step-num s1">1</div><div><div class="how-step-title">Incele</div><div class="how-step-desc">Mevcut yapiyi ve kodu gor</div></div></div>
                <div class="how-step"><div class="how-step-num s2">2</div><div><div class="how-step-title">Tanimla</div><div class="how-step-desc">Degisikligi detayli anlat</div></div></div>
                <div class="how-step"><div class="how-step-num s3">3</div><div><div class="how-step-title">Derle</div><div class="how-step-desc">Otomatik duzeltme ile deploy</div></div></div>
            </div>
            <div class="sidebar-card">
                <h6><i class="bi bi-magic"></i> Örnek İstekler</h6>
                <div class="edit-example-list">
                    <div class="edit-example" onclick="insertEditHint('Yeni /spawn komutu ekle, oyuncuyu spawn noktasina isinlasin')"><i class="bi bi-terminal text-warning"></i> /spawn komutu</div>
                    <div class="edit-example" onclick="insertEditHint('Oyuncu olunce particle efekt gostersin')"><i class="bi bi-stars text-info"></i> Olum efekti</div>
                    <div class="edit-example" onclick="insertEditHint('Config.yml dosyasindan ayarlari okusun')"><i class="bi bi-gear text-success"></i> Config destegi</div>
                    <div class="edit-example" onclick="insertEditHint('Tum mesajlari Turkceye cevir ve renklendir')"><i class="bi bi-translate text-danger"></i> Turkce & renk</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script>
    // ========== STATE ==========
    let state = {
        pluginName: '',
        description: '',
        questions: [],
        blueprint: null,
        blueprintJson: '',
        generatedCode: '',
        editContext: null,
        editHistory: '',
        editCode: ''
    };

    // ========== WIZARD FLOW ==========
    async function startWizard() {
        const name = document.getElementById('pluginName').value.trim();
        const desc = document.getElementById('pluginDesc').value.trim();
        if (!name || !desc) { alert('Plugin adi ve aciklama gerekli!'); return; }

        state.pluginName = name;
        state.description = desc;

        document.getElementById('stepCreate').style.display = 'none';
        document.getElementById('wizardMain').style.display = 'block';
        document.getElementById('wizPluginTitle').textContent = name;

        // Show step 1
        showStep(1);

        // Get questions from AI
        try {
            const res = await fetch('/PluginBuilder/GetQuestions', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name, description: desc })
            });
            const data = await res.json();
            if (data.success && data.questions) {
                state.questions = data.questions;
                renderQuestions(data.questions);
            } else {
                document.getElementById('questionsList').innerHTML =
                    '<div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> ' + (data.error || 'Soru uretilemedi') + '</div>';
            }
        } catch (e) {
            document.getElementById('questionsList').innerHTML =
                '<div class="alert alert-danger">Baglanti hatasi: ' + e.message + '</div>';
        }
    }

    function renderQuestions(questions) {
        let html = '';
        questions.forEach((q, i) => {
            html += `
            <div class="question-item">
                <div class="d-flex align-items-start">
                    <span class="q-number" id="qnum${i}">${i + 1}</span>
                    <div class="flex-fill">
                        <div class="q-text">${escapeHtml(q.question)}</div>
                        <input type="text" class="form-control q-input" id="qanswer${i}"
                               placeholder="${escapeHtml(q.placeholder || 'Cevabin...')}"
                               oninput="updateQuestionProgress()" />
                    </div>
                </div>
            </div>`;
        });
        document.getElementById('questionsList').innerHTML = html;
        document.getElementById('btnSubmitAnswers').disabled = false;
        updateQuestionProgress();
    }

    function updateQuestionProgress() {
        const total = state.questions.length || 5;
        let answered = 0;
        for (let i = 0; i < total; i++) {
            const el = document.getElementById('qanswer' + i);
            const numEl = document.getElementById('qnum' + i);
            if (el && el.value.trim()) {
                answered++;
                if (numEl) numEl.classList.add('answered');
            } else {
                if (numEl) numEl.classList.remove('answered');
            }
        }
        const pct = Math.round((answered / total) * 100);
        document.getElementById('questionProgress').style.width = pct + '%';
        document.getElementById('questionCount').textContent = answered + '/' + total;
    }

    async function submitAnswers() {
        const answers = state.questions.map((q, i) => {
            const el = document.getElementById('qanswer' + i);
            return { id: q.id, question: q.question, answer: el ? el.value.trim() : '', placeholder: q.placeholder };
        });

        document.getElementById('btnSubmitAnswers').disabled = true;
        document.getElementById('btnSubmitAnswers').innerHTML = '<div class="wizard-spinner"></div> Blueprint hazirlaniyor...';

        try {
            const res = await fetch('/PluginBuilder/GenerateBlueprint', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name: state.pluginName, description: state.description, answers })
            });
            const data = await res.json();
            if (data.success && data.blueprint) {
                state.blueprint = data.blueprint;
                state.blueprintJson = data.blueprint.rawBlueprintJson || JSON.stringify(data.blueprint);
                showStep(2);
                renderBlueprint(data.blueprint);
            } else {
                alert('Blueprint olusturulamadi: ' + (data.error || 'Bilinmeyen hata'));
                document.getElementById('btnSubmitAnswers').disabled = false;
                document.getElementById('btnSubmitAnswers').innerHTML = '<i class="bi bi-check2-circle"></i> Gonder & Devam Et';
            }
        } catch (e) {
            alert('Baglanti hatasi: ' + e.message);
            document.getElementById('btnSubmitAnswers').disabled = false;
            document.getElementById('btnSubmitAnswers').innerHTML = '<i class="bi bi-check2-circle"></i> Gonder & Devam Et';
        }
    }

    function renderBlueprint(bp) {
        const g = bp.general || {};
        const cmds = bp.commands || [];
        const perms = bp.permissions || [];
        const stories = bp.userStories || [];
        const tech = bp.technical || {};
        const events = tech.eventListeners || [];
        const classes = tech.classes || [];
        const apis = tech.apiMethods || [];

        let html = '';

        // General Info
        html += `<div class="wiz-card"><div class="wiz-card-header" onclick="toggleSection('secGeneral')">
            <i class="bi bi-info-circle-fill text-info"></i><h5>General Information</h5>
            <i class="bi bi-chevron-up ms-auto text-muted" id="secGeneralIcon"></i>
        </div><div class="wiz-card-body" id="secGeneral">
            <p class="text-muted" style="line-height:1.7;">${escapeHtml(g.detailedDescription || g.summary || bp.description || '')}</p>
            ${(g.features||[]).length ? '<div class="mt-2"><strong class="text-white small">Ozellikler:</strong><ul class="text-muted small mt-1">' + (g.features||[]).map(f=>'<li>'+escapeHtml(f)+'</li>').join('') + '</ul></div>' : ''}
        </div></div>`;

        // Commands & Permissions
        html += `<div class="wiz-card"><div class="wiz-card-header" onclick="toggleSection('secCmds')">
            <i class="bi bi-terminal-fill text-warning"></i><h5>Commands & Permissions</h5>
            <span class="badge bg-secondary ms-2">${cmds.length + perms.length}</span>
            <i class="bi bi-chevron-up ms-auto text-muted" id="secCmdsIcon"></i>
        </div><div class="wiz-card-body" id="secCmds">`;
        if (cmds.length) {
            cmds.forEach(c => {
                html += `<div class="mb-2"><code class="text-warning">${escapeHtml(c.name)}</code> — <span class="text-muted small">${escapeHtml(c.description)}</span>
                ${c.permission ? '<br><span class="text-muted small">Izin: <code>'+escapeHtml(c.permission)+'</code></span>' : ''}</div>`;
            });
        }
        if (perms.length) {
            html += '<div class="mt-2"><strong class="text-white small">Permissions:</strong></div>';
            perms.forEach(p => {
                html += `<div class="small text-muted"><code>${escapeHtml(p.node)}</code> — ${escapeHtml(p.description)} (default: ${p.default || 'op'})</div>`;
            });
        }
        if (!cmds.length && !perms.length) html += '<p class="text-muted small">Komut veya izin tanimlanmamis.</p>';
        html += '</div></div>';

        // User Stories
        if (stories.length) {
            html += `<div class="wiz-card"><div class="wiz-card-header" onclick="toggleSection('secStories')">
                <i class="bi bi-people-fill text-success"></i><h5>User Stories</h5>
                <span class="badge bg-secondary ms-2">${stories.length}</span>
                <i class="bi bi-chevron-up ms-auto text-muted" id="secStoriesIcon"></i>
            </div><div class="wiz-card-body" id="secStories">`;
            stories.forEach(s => {
                const tagClass = s.role === 'ADMIN' ? 'bp-tag-yellow' : s.role === 'DEVELOPER' ? 'bp-tag-purple' : 'bp-tag-green';
                html += `<div class="story-card"><span class="bp-tag ${tagClass}">${escapeHtml(s.role)}</span>
                    <p class="text-muted small mb-0 mt-1">${escapeHtml(s.story)}</p></div>`;
            });
            html += '</div></div>';
        }

        // Technical Details
        html += `<div class="wiz-card"><div class="wiz-card-header" onclick="toggleSection('secTech')">
            <i class="bi bi-gear-fill text-danger"></i><h5>Technical Details</h5>
            <i class="bi bi-chevron-up ms-auto text-muted" id="secTechIcon"></i>
        </div><div class="wiz-card-body" id="secTech">`;

        if (events.length) {
            html += '<div class="small text-muted text-uppercase fw-bold mb-2">Event Listeners</div>';
            events.forEach(e => {
                html += `<div class="d-flex align-items-center gap-2 mb-2">
                    <code class="bp-tag bp-tag-blue">${escapeHtml(e.eventName)}</code>
                    <span class="text-muted small flex-fill">${escapeHtml(e.description)}</span>
                    ${e.verified ? '<i class="bi bi-check-circle-fill verified-icon"></i>' : ''}
                </div>`;
            });
        }

        if (classes.length) {
            html += '<div class="small text-muted text-uppercase fw-bold mb-2 mt-3">Classes</div>';
            classes.forEach(c => {
                const typeTag = c.type === 'MAIN CLASS' ? 'bp-tag-green' : c.type === 'EVENT LISTENER CLASS' ? 'bp-tag-blue' : c.type === 'MANAGER' ? 'bp-tag-purple' : 'bp-tag-yellow';
                html += `<div class="d-flex align-items-start gap-2 mb-2">
                    <span class="bp-tag ${typeTag}">${escapeHtml(c.type)}</span>
                    <div><strong class="text-white">${escapeHtml(c.name)}</strong>
                    <p class="text-muted small mb-0">${escapeHtml(c.description)}</p></div>
                </div>`;
            });
        }

        if (apis.length) {
            html += '<div class="small text-muted text-uppercase fw-bold mb-2 mt-3">API Methods</div>';
            apis.forEach(a => {
                html += `<div class="d-flex align-items-center gap-2 mb-2">
                    <code class="bp-tag bp-tag-red">${escapeHtml(a.signature)}</code>
                    <span class="text-muted small">${escapeHtml(a.source)}</span>
                    <span class="text-muted small flex-fill">${escapeHtml(a.description)}</span>
                    ${a.verified ? '<i class="bi bi-check-circle-fill verified-icon"></i>' : ''}
                </div>`;
            });
        }
        html += '</div></div>';

        document.getElementById('blueprintContent').innerHTML = html;
        document.getElementById('btnGenerateRelease').style.display = 'block';
    }

    function toggleSection(id) {
        const el = document.getElementById(id);
        const ico = document.getElementById(id + 'Icon');
        if (el.style.display === 'none') {
            el.style.display = 'block';
            if (ico) ico.className = 'bi bi-chevron-up ms-auto text-muted';
        } else {
            el.style.display = 'none';
            if (ico) ico.className = 'bi bi-chevron-down ms-auto text-muted';
        }
    }

    async function generateRelease() {
        showStep(3);

        document.getElementById('buildStatus').innerHTML = `
            <div class="text-center py-4">
                <div class="wizard-spinner"></div>
                <p class="text-warning mt-3 fw-bold">Kod uretiliyor ve derleniyor...</p>
                <p class="text-muted small">AI plugin kodunu yaziyor, Maven ile derliyor. Hatalar otomatik duzeltilecek.<br>Bu islem 1-5 dakika surebilir.</p>
            </div>`;

        try {
            const res = await fetch('/PluginBuilder/GenerateAndBuild', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ pluginName: state.pluginName, blueprintJson: state.blueprintJson })
            });
            const data = await res.json();

            if (data.success) {
                state.generatedCode = data.code || '';
                document.getElementById('buildStatus').innerHTML = `
                    <div class="text-center py-4">
                        <i class="bi bi-check-circle-fill text-success" style="font-size:3rem;"></i>
                        <h4 class="text-success mt-3">Basariyla Derlendi!</h4>
                        <p class="text-muted">${escapeHtml(data.message || '')}</p>
                        ${data.retries ? '<p class="text-muted small">Otomatik duzeltme sayisi: ' + data.retries + '</p>' : ''}
                        <div class="mt-3">
                            <p class="text-warning"><i class="bi bi-info-circle"></i> Plugin sunucuya deploy edildi. Sunucuyu yeniden baslatin.</p>
                        </div>
                    </div>`;
            } else {
                const errorHtml = data.error ? escapeHtml(data.error) : 'Bilinmeyen hata';
                const buildOutput = data.buildOutput ? `<div class="build-output mt-3">${escapeHtml(data.buildOutput)}</div>` : '';
                document.getElementById('buildStatus').innerHTML = `
                    <div class="py-3">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <i class="bi bi-x-circle-fill text-danger" style="font-size:1.5rem;"></i>
                            <h5 class="text-danger mb-0">Derleme Basarisiz</h5>
                        </div>
                        <pre class="build-output">${errorHtml}</pre>
                        ${buildOutput}
                        <div class="mt-3 d-flex gap-2">
                            <button class="btn btn-mc-gold" onclick="generateRelease()"><i class="bi bi-arrow-repeat"></i> Tekrar Dene</button>
                            <button class="btn btn-outline-secondary" onclick="showStep(2)"><i class="bi bi-arrow-left"></i> Blueprint'e Don</button>
                        </div>
                    </div>`;
            }
        } catch (e) {
            document.getElementById('buildStatus').innerHTML = `
                <div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> Baglanti hatasi: ${escapeHtml(e.message)}</div>
                <button class="btn btn-mc-gold mt-2" onclick="generateRelease()"><i class="bi bi-arrow-repeat"></i> Tekrar Dene</button>`;
        }
    }

    function showStep(step) {
        // Hide all steps
        ['stepQuestions', 'stepBlueprint', 'stepBuild'].forEach(id => {
            document.getElementById(id).style.display = 'none';
        });

        // Show target step
        if (step === 1) document.getElementById('stepQuestions').style.display = 'block';
        if (step === 2) document.getElementById('stepBlueprint').style.display = 'block';
        if (step === 3) document.getElementById('stepBuild').style.display = 'block';

        // Update stepper
        for (let i = 1; i <= 3; i++) {
            const s = document.getElementById('stepper' + i);
            s.classList.remove('active', 'completed', 'disabled');
            if (i < step) s.classList.add('completed');
            else if (i === step) s.classList.add('active');
            else s.classList.add('disabled');
        }
    }

    function goBack() {
        document.getElementById('wizardMain').style.display = 'none';
        document.getElementById('stepCreate').style.display = 'block';
    }

    // ========== EDIT MODE (Premium) ==========
    let editState = {
        pluginName: '',
        cleanName: '',
        files: {},
        rawCode: '',
        chatHistory: '',
        parsedFiles: [],
        activeTabIdx: 0,
        isBuilding: false
    };

    function loadPluginSource(name) { editPluginWithAI(name); }

    async function editPluginWithAI(name) {
        editState = { pluginName: name, cleanName: name.replace(/Project$/, ''), files: {}, rawCode: '', chatHistory: '', parsedFiles: [], activeTabIdx: 0, isBuilding: false };

        document.getElementById('stepCreate').style.display = 'none';
        document.getElementById('wizardMain').style.display = 'none';
        document.getElementById('editMode').style.display = 'block';
        document.getElementById('editPluginTitle').textContent = editState.cleanName;
        editShowStep(1);
        document.getElementById('editAnalyzeLoading').style.display = 'block';
        document.getElementById('editAnalyzeReady').style.display = 'none';
        document.getElementById('editPluginDetails').innerHTML = '<div class="text-center py-3"><div class="wizard-spinner"></div></div>';
        document.getElementById('editChatMessages').innerHTML = '';

        try {
            const res = await fetch('/PluginBuilder/GetPluginSource?name=' + encodeURIComponent(name));
            const data = await res.json();
            if (data.success && data.files) {
                editState.files = data.files;
                let allCode = '';
                for (const [path, content] of Object.entries(data.files)) {
                    const ext = path.endsWith('.xml') ? 'xml' : path.endsWith('.yml') ? 'yaml' : 'java';
                    allCode += '// FILE: ' + path + '\n```' + ext + '\n' + content + '\n```\n\n';
                }
                editState.rawCode = allCode;
                editState.parsedFiles = Object.entries(data.files).map(([p, c]) => ({ path: p, content: c }));
                renderEditAnalysis(data.files);
                document.getElementById('editBadgeFiles').innerHTML = '<i class="bi bi-files"></i> ' + Object.keys(data.files).length + ' dosya';
                document.getElementById('editAnalyzeLoading').style.display = 'none';
                document.getElementById('editAnalyzeReady').style.display = 'block';
            } else {
                document.getElementById('editAnalyzeLoading').innerHTML = '<div class="wiz-card-body"><div class="alert alert-danger mb-0"><i class="bi bi-exclamation-triangle"></i> ' + escapeHtml(data.error || 'Plugin yuklenemedi') + '</div></div>';
            }
        } catch (e) {
            document.getElementById('editAnalyzeLoading').innerHTML = '<div class="wiz-card-body"><div class="alert alert-danger mb-0">Baglanti hatasi: ' + escapeHtml(e.message) + '</div></div>';
        }
    }

    function renderEditAnalysis(files) {
        const paths = Object.keys(files);
        const javaFiles = paths.filter(p => p.endsWith('.java'));
        const totalLines = Object.values(files).reduce((s, c) => s + c.split('\n').length, 0);
        const cmds = new Set();
        const events = new Set();
        Object.values(files).forEach(c => {
            for (const m of c.matchAll(/getCommand\(["'](\w+)["']\)/g)) cmds.add('/' + m[1]);
            for (const m of c.matchAll(/@@EventHandler[\s\S]*?public\s+void\s+\w+\((\w+Event)/g)) events.add(m[1]);
        });

        document.getElementById('editStats').innerHTML =
            '<div class="edit-stat-card"><div class="edit-stat-icon text-info"><i class="bi bi-files"></i></div><div class="edit-stat-value">' + paths.length + '</div><div class="edit-stat-label">Dosya</div></div>' +
            '<div class="edit-stat-card"><div class="edit-stat-icon text-warning"><i class="bi bi-filetype-java"></i></div><div class="edit-stat-value">' + javaFiles.length + '</div><div class="edit-stat-label">Java Sınıfı</div></div>' +
            '<div class="edit-stat-card"><div class="edit-stat-icon text-success"><i class="bi bi-code"></i></div><div class="edit-stat-value">' + totalLines + '</div><div class="edit-stat-label">Satır</div></div>' +
            '<div class="edit-stat-card"><div class="edit-stat-icon text-danger"><i class="bi bi-terminal"></i></div><div class="edit-stat-value">' + cmds.size + '</div><div class="edit-stat-label">Komut</div></div>';

        // File tree
        let treeHtml = '';
        paths.forEach((p, i) => {
            const fn = p.split('/').pop();
            const icon = getFileIcon(fn);
            treeHtml += '<div class="edit-file-item' + (i === 0 ? ' active' : '') + '" onclick="previewEditFile(' + i + ')" data-idx="' + i + '">' +
                '<i class="file-icon ' + icon.cls + '" style="color:' + icon.color + '"></i>' +
                '<div><div class="file-name">' + escapeHtml(fn) + '</div><div class="file-path">' + escapeHtml(p) + '</div></div></div>';
        });
        document.getElementById('editFileTree').innerHTML = treeHtml;

        // Plugin details sidebar
        let detailsHtml = '';
        const ymlEntry = Object.entries(files).find(([p]) => p.endsWith('plugin.yml'));
        if (ymlEntry) {
            const nameM = ymlEntry[1].match(/^name:\s*(.+)$/m);
            const verM = ymlEntry[1].match(/^version:\s*(.+)$/m);
            const mainM = ymlEntry[1].match(/^main:\s*(.+)$/m);
            if (nameM) detailsHtml += '<div class="info-row"><span class="info-label">ADI</span><span class="info-value">' + escapeHtml(nameM[1].trim()) + '</span></div>';
            if (verM) detailsHtml += '<div class="info-row"><span class="info-label">VERSIYON</span><span class="info-value">' + escapeHtml(verM[1].trim()) + '</span></div>';
            if (mainM) detailsHtml += '<div class="info-row"><span class="info-label">MAIN CLASS</span><span class="info-value" style="font-size:0.7rem;">' + escapeHtml(mainM[1].trim()) + '</span></div>';
        }
        detailsHtml += '<div class="info-row"><span class="info-label">JAVA DOSYA</span><span class="info-value">' + javaFiles.length + '</span></div>';
        detailsHtml += '<div class="info-row"><span class="info-label">TOPLAM SATIR</span><span class="info-value">' + totalLines + '</span></div>';
        if (cmds.size) detailsHtml += '<div class="info-row"><span class="info-label">KOMUTLAR</span><span class="info-value">' + [...cmds].join(', ') + '</span></div>';
        if (events.size) detailsHtml += '<div class="info-row"><span class="info-label">EVENTLER</span><span class="info-value">' + events.size + '</span></div>';
        detailsHtml += '<div class="info-row"><span class="info-label">PLATFORM</span><span class="info-value">Spigot 1.21</span></div>';
        detailsHtml += '<div class="info-row"><span class="info-label">JAVA</span><span class="info-value">21</span></div>';
        document.getElementById('editPluginDetails').innerHTML = detailsHtml;

        if (paths.length > 0) previewEditFile(0);
    }

    function getFileIcon(fn) {
        if (fn === 'pom.xml') return { cls: 'bi bi-file-earmark-ruled-fill', color: '#ef4444' };
        if (fn === 'plugin.yml') return { cls: 'bi bi-gear-wide-connected', color: '#fbbf24' };
        if (fn.endsWith('.java')) return { cls: 'bi bi-filetype-java', color: '#f97316' };
        if (fn.endsWith('.xml')) return { cls: 'bi bi-filetype-xml', color: '#ef4444' };
        if (fn.endsWith('.yml') || fn.endsWith('.yaml')) return { cls: 'bi bi-filetype-yml', color: '#fbbf24' };
        return { cls: 'bi bi-file-earmark-text', color: '#94a3b8' };
    }

    function previewEditFile(idx) {
        const paths = Object.keys(editState.files);
        if (idx >= paths.length) return;
        document.getElementById('editPreviewCode').textContent = editState.files[paths[idx]];
        document.getElementById('editPreviewTitle').textContent = paths[idx].split('/').pop();
        document.querySelectorAll('#editFileTree .edit-file-item').forEach((el, i) => el.classList.toggle('active', i === idx));
    }

    function editGoToModify() {
        editShowStep(2);
        renderEditCodeTabs(editState.parsedFiles);
        if (!document.getElementById('editChatMessages').children.length) {
            addEditChatMsg('Plugin yuklendi (' + editState.parsedFiles.length + ' dosya). Ne degistirmek istiyorsun?', 'ai');
        }
        setTimeout(() => document.getElementById('editChatInput')?.focus(), 100);
    }

    function editShowStep(step) {
        ['editStep1', 'editStep2', 'editStep3'].forEach(id => document.getElementById(id).style.display = 'none');
        document.getElementById('editStep' + step).style.display = 'block';
        for (let i = 1; i <= 3; i++) {
            const el = document.getElementById('eStep' + i);
            el.classList.remove('active', 'completed', 'disabled');
            if (i < step) el.classList.add('completed');
            else if (i === step) el.classList.add('active');
            else el.classList.add('disabled');
        }
    }

    function renderEditCodeTabs(files) {
        if (!files.length) return;
        let html = '';
        files.forEach((f, i) => {
            const fn = f.path.split('/').pop();
            const icon = getFileIcon(fn);
            html += '<div class="edit-file-tab' + (i === 0 ? ' active' : '') + '" onclick="switchEditTab(' + i + ')">' +
                '<i class="tab-icon ' + icon.cls + '" style="color:' + icon.color + '"></i> ' + escapeHtml(fn) + '</div>';
        });
        document.getElementById('editCodeTabs').innerHTML = html;
        document.getElementById('editCodeFileCount').textContent = files.length + ' dosya';
        switchEditTab(0);
    }

    function switchEditTab(idx) {
        if (idx >= editState.parsedFiles.length) return;
        editState.activeTabIdx = idx;
        document.getElementById('editCodeView').textContent = editState.parsedFiles[idx].content;
        document.querySelectorAll('.edit-file-tab').forEach((el, i) => el.classList.toggle('active', i === idx));
    }

    // Chat
    async function sendEditChat() {
        const input = document.getElementById('editChatInput');
        const msg = input.value.trim();
        if (!msg) return;
        addEditChatMsg(msg, 'user');
        input.value = '';
        input.disabled = true;
        document.getElementById('btnEditSend').disabled = true;

        const typingId = showEditTyping();
        const codeContext = editState.rawCode
            ? '\n--- MEVCUT PLUGIN: ' + editState.pluginName + ' ---\n' + editState.rawCode + '\nISTEK: ' + msg
            : msg;

        try {
            const res = await fetch('/PluginBuilder/Chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: codeContext, history: editState.chatHistory })
            });
            const data = await res.json();
            removeEditTyping(typingId);

            if (data.success) {
                addEditChatMsg(data.content, 'ai');
                editState.chatHistory += '\nKullanici: ' + msg + '\nAI: ' + data.content + '\n';
                editState.rawCode = data.content;
                const parsed = parseEditFiles(data.content);
                if (parsed.length > 0) {
                    editState.parsedFiles = parsed;
                    renderEditCodeTabs(parsed);
                }
            } else {
                addEditChatMsg('Hata: ' + (data.error || 'Bilinmeyen'), 'ai');
            }
        } catch (e) {
            removeEditTyping(typingId);
            addEditChatMsg('Baglanti hatasi: ' + e.message, 'ai');
        }
        input.disabled = false;
        document.getElementById('btnEditSend').disabled = false;
        input.focus();
    }

    function addEditChatMsg(text, type) {
        const c = document.getElementById('editChatMessages');
        const d = document.createElement('div');
        d.className = 'edit-chat-msg ' + type;
        if (type === 'user') {
            d.innerHTML = '<div class="edit-chat-sender">Sen</div><div class="edit-chat-bubble">' + escapeHtml(text) + '</div>';
        } else {
            let rendered = text;
            try { rendered = marked.parse(text); } catch (e) { rendered = escapeHtml(text); }
            d.innerHTML = '<div class="edit-chat-sender">AI Asistan</div><div class="edit-chat-bubble">' + rendered + '</div>';
        }
        c.appendChild(d);
        c.scrollTop = c.scrollHeight;
    }

    let _typingCounter = 0;
    function showEditTyping() {
        const id = 'typing-' + (++_typingCounter);
        const c = document.getElementById('editChatMessages');
        const d = document.createElement('div');
        d.className = 'edit-chat-msg ai';
        d.id = id;
        d.innerHTML = '<div class="edit-chat-sender">AI Asistan</div><div class="edit-chat-bubble"><div class="edit-typing-dots"><span></span><span></span><span></span></div></div>';
        c.appendChild(d);
        c.scrollTop = c.scrollHeight;
        return id;
    }

    function removeEditTyping(id) { document.getElementById(id)?.remove(); }

    function clearEditChat() {
        document.getElementById('editChatMessages').innerHTML = '';
        editState.chatHistory = '';
        addEditChatMsg('Sohbet temizlendi. Ne yapmak istiyorsun?', 'ai');
    }

    function insertEditHint(text) {
        const input = document.getElementById('editChatInput');
        if (input) { input.value = text; input.focus(); }
    }

    function parseEditFiles(code) {
        const files = [];
        const pattern = /\/\/\s*FILE:\s*(.+?)\s*\n```(?:java|xml|ya?ml)\s*\n([\s\S]*?)```/g;
        let m;
        while ((m = pattern.exec(code)) !== null) {
            files.push({ path: m[1].trim(), content: m[2].trim() });
        }
        return files;
    }

    // Build
    async function startEditBuild() {
        if (editState.isBuilding) return;
        editState.isBuilding = true;
        editShowStep(3);

        const phases = [
            { icon: 'bi-file-earmark-code', label: 'Kod Ayristirma', desc: 'Dosyalar ayristiriliyor...' },
            { icon: 'bi-gear-wide-connected', label: 'Derleme', desc: 'Maven ile derleniyor...' },
            { icon: 'bi-box-seam', label: 'Paketleme', desc: 'JAR dosyasi olusturuluyor...' },
            { icon: 'bi-cloud-upload', label: 'Deploy', desc: 'Sunucuya yukleniyor...' }
        ];

        function renderPhases(statuses) {
            return '<div class="edit-build-phases">' + phases.map((p, i) => {
                const st = statuses[i] || 'pending';
                const iconHtml = st === 'done' ? '<i class="bi bi-check-lg"></i>' : st === 'error' ? '<i class="bi bi-x-lg"></i>' : '<i class="bi ' + p.icon + '"></i>';
                return '<div class="edit-build-phase ' + st + '"><div class="edit-phase-icon">' + iconHtml + '</div><div><div class="edit-phase-label">' + p.label + '</div><div class="edit-phase-desc">' + p.desc + '</div></div></div>';
            }).join('') + '</div>';
        }

        const pluginName = editState.cleanName;
        const sourcePlugin = editState.pluginName;
        const MAX_RETRIES = 5;
        let currentCode = editState.rawCode;

        let statuses = ['active', 'pending', 'pending', 'pending'];
        document.getElementById('editBuildContent').innerHTML = renderPhases(statuses);
        document.getElementById('editBuildActions').style.display = 'none';

        const t1 = setTimeout(() => {
            statuses = ['done', 'active', 'pending', 'pending'];
            document.getElementById('editBuildContent').innerHTML = renderPhases(statuses);
        }, 800);
        const t2 = setTimeout(() => {
            statuses = ['done', 'done', 'active', 'pending'];
            document.getElementById('editBuildContent').innerHTML = renderPhases(statuses);
        }, 4000);

        for (let attempt = 0; attempt <= MAX_RETRIES; attempt++) {
            try {
                if (attempt > 0) {
                    document.getElementById('editBuildContent').innerHTML =
                        '<div class="text-center py-2 mb-2"><span class="edit-retry-badge"><i class="bi bi-arrow-repeat"></i> Otomatik Duzeltme: ' + attempt + '. deneme</span></div>' +
                        renderPhases(['done', 'active', 'pending', 'pending']);
                }

                const res = await fetch('/PluginBuilder/Build', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ pluginName, code: currentCode, sourcePlugin })
                });
                const data = await res.json();

                if (data.success) {
                    clearTimeout(t1); clearTimeout(t2);
                    document.getElementById('editBuildContent').innerHTML =
                        (attempt > 0 ? '<div class="text-center mb-2"><span class="edit-retry-badge"><i class="bi bi-check-lg"></i> ' + attempt + '. denemede basarili</span></div>' : '') +
                        renderPhases(['done', 'done', 'done', 'done']) +
                        '<div class="edit-success-container">' +
                        '<div class="edit-success-icon"><i class="bi bi-check-circle-fill"></i></div>' +
                        '<h4 class="text-success mt-3">Basariyla Derlendi!</h4>' +
                        '<p class="text-muted">' + escapeHtml(data.message || '') + '</p>' +
                        '<div class="mt-3"><p class="text-warning small"><i class="bi bi-info-circle"></i> Plugin sunucuya deploy edildi. Sunucuyu yeniden baslatin veya <code>/reload</code> yapin.</p></div>' +
                        '</div>';
                    document.getElementById('editBuildActions').style.display = 'flex';
                    editState.isBuilding = false;
                    return;
                }

                if (attempt < MAX_RETRIES && data.buildOutput) {
                    const errors = extractMavenErrors(data.buildOutput);
                    const fixRes = await fetch('/PluginBuilder/Chat', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ message: 'DERLEME HATASI:\n' + errors + '\nKOD:\n' + currentCode + '\nDUZELT!', history: '' })
                    });
                    const fixData = await fixRes.json();
                    if (fixData.success) {
                        currentCode = fixData.content;
                        editState.rawCode = currentCode;
                        const parsed = parseEditFiles(currentCode);
                        if (parsed.length) editState.parsedFiles = parsed;
                        continue;
                    }
                }

                clearTimeout(t1); clearTimeout(t2);
                document.getElementById('editBuildContent').innerHTML =
                    renderPhases(['done', 'error', 'pending', 'pending']) +
                    '<div class="mt-3"><div class="d-flex align-items-center gap-2 mb-2"><i class="bi bi-x-circle-fill text-danger" style="font-size:1.2rem;"></i> <strong class="text-danger">Derleme Basarisiz</strong></div>' +
                    '<pre class="build-output">' + escapeHtml(data.error || data.buildOutput || 'Bilinmeyen hata') + '</pre></div>';
                document.getElementById('editBuildActions').style.display = 'flex';
                break;
            } catch (e) {
                clearTimeout(t1); clearTimeout(t2);
                document.getElementById('editBuildContent').innerHTML =
                    '<div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> Baglanti hatasi: ' + escapeHtml(e.message) + '</div>';
                document.getElementById('editBuildActions').style.display = 'flex';
                break;
            }
        }
        editState.isBuilding = false;
    }

    function exitEditMode() {
        document.getElementById('editMode').style.display = 'none';
        document.getElementById('stepCreate').style.display = 'block';
    }

    function extractMavenErrors(output) {
        if (!output) return '';
        return output.split('\n').filter(l =>
            l.includes('[ERROR]') || l.includes('cannot find symbol') || l.includes('error:') || l.includes('COMPILATION ERROR')
        ).slice(0, 20).join('\n') || output.substring(0, 1500);
    }

    function escapeHtml(t) {
        const d = document.createElement('div');
        d.textContent = t;
        return d.innerHTML;
    }

    // Enter key for edit chat
    document.getElementById('editChatInput')?.addEventListener('keydown', e => {
        if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendEditChat(); }
    });
    </script>
}
