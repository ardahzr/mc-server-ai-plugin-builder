        <a href="#nasil-calisir">Nasıl Çalışır</a>
        <a href="#fiyatlar">Fiyatlar</a>
        <a href="#sss">SSS</a>
        <a asp-controller="PluginBuilder" asp-action="Index">Plugin Builder</a>
        <div class="divider"></div>
        <a asp-controller="Server" asp-action="Index">Konsol</a>
        <a class="m-start" asp-controller="PluginBuilder" asp-action="Index">
